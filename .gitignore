assets/tex/*.jpg
assets/tex/*.png
assets/tex_hd/*.jpg
assets/tex_hd/*.png
assets/models/**/*.gltf
assets/models/**/*.bin
assets/models/**/*.jpg
assets/models_hd/**/*.gltf
assets/models_hd/**/*.bin
assets/models_hd/**/*.jpg

# sistema
.DS_Store
Thumbs.db
__pycache__/
*.blend1
*.blend2
art/vendor/
.autoconverted/
assets/models/**/textures/
export_presets.cfg.bak
assets/models/qnat/

!patches/*.exe

# Unreal: generated output stays out of Git
unreal/**/Binaries/
unreal/**/Intermediate/
unreal/**/Saved/
unreal/**/DerivedDataCache/
unreal/**/*.sln
unreal/**/*.VC.db
unreal/**/.vs/
# Export bruto e saídas temporárias; Models/Textures são fontes portáveis.
unreal/**/SourceArt/World/
**/__pycache__/
unreal/**/*.pyc
unreal/**/SourceArt/**/*.blend1

# Fab outfits (MetaHuman parametric wardrobe, Fab Standard License; ~7 GB): re-download with the list in
# docs/ue58/ROUPAS_FAB.md and install by the .mhpkg manifest (base path from dependentPackages).
unreal/MareAlta/Content/Outfits/
unreal/MareAlta/Content/OutFits/
unreal/MareAlta/Content/MetaOutfits/
unreal/MareAlta/Content/People/MetaHumans/*_Beach/
unreal/MareAlta/Content/People/MetaHumans/MH_*_Beach.uasset
